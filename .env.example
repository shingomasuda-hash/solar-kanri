# ---------------------------------------------------------------- database
# PostgreSQL connection string. See docs/setup/database.md
DATABASE_URL="postgresql://solar:CHANGE_ME@localhost:5432/solar_kanri?schema=public"

# ------------------------------------------------------------------ session
# Random secret for session signing. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Must be at least 32 characters. NEVER commit the real value.
SESSION_SECRET="CHANGE_ME_at_least_32_characters_long"

# Password given to every seeded account. Change it, then change it again in
# the app after first login.
SEED_ADMIN_PASSWORD="ChangeMeImmediately!2026"

# --------------------------------------------------------- Google Maps (OI-004)
# Required for address search, satellite view and roof drawing.
# Setup instructions: docs/setup/google-maps.md
#
# Browser key. Exposed to the client by design — restrict it by HTTP referrer
# in the Google Cloud console, and enable ONLY:
#   Maps JavaScript API, Geocoding API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# Map ID for a vector map style. Optional; create one under
# Google Cloud console → Google Maps Platform → Map management.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=""

# Server-side key for the Geocoding API, restricted by IP rather than referrer.
# Prefer this over the browser key for geocoding: it keeps quota off a key that
# anyone can read out of the page.
GOOGLE_GEOCODING_API_KEY=""

# ------------------------------------------------------- Google Solar (optional)
# Supplementary only. The platform works fully without it — an operator draws
# the roof by hand. Billed per request.
GOOGLE_SOLAR_API_KEY=""

# ---------------------------------------------------------- solar data providers
# Comma-separated, in preference order. Available: manual, pvgis
SOLAR_PROVIDER_ORDER="manual,pvgis"
# PVGIS needs no key. Set to "false" to disable it entirely.
PVGIS_ENABLED="true"

# ------------------------------------------------------------- AI (OI-005)
# The Copilot is disabled and everything else works when this is empty.
# Provider: anthropic | openai
AI_PROVIDER="anthropic"
ANTHROPIC_API_KEY=""
# Model identifier. Kept in configuration so changing it is an admin action,
# not a deployment (ADR-006).
AI_MODEL="claude-sonnet-5"
OPENAI_API_KEY=""

# ------------------------------------------------------------------- runtime
# Local development only. NEVER set this in a hosting dashboard — the platform
# sets it correctly itself, and a stale "development" there changes runtime
# behaviour on a live site.
NODE_ENV="development"
